<div class="pl-tablet-input" data-options="{{options_json}}">
  {{#editable}}
  <div class="pl-tablet-input-toolbar" role="toolbar" aria-label="Tablet input tools">
    <button type="button" class="btn btn-light border js-tablet-input-undo" aria-label="Undo last stroke" title="Undo last stroke">
      <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
    </button>
    <button type="button" class="btn btn-light border js-tablet-input-clear" aria-label="Clear tablet input" title="Clear tablet input">
      <i class="bi bi-trash3" aria-hidden="true"></i>
    </button>
    {{#telemetry}}<span class="small text-muted">Pen data collected</span>{{/telemetry}}
  </div>
  {{/editable}}
  {{#replay}}
  <div class="pl-tablet-input-toolbar" role="toolbar" aria-label="Tablet input replay">
    <button type="button" class="btn btn-light border js-tablet-input-replay" aria-label="Play tablet input replay" title="Play tablet input replay">
      <i class="bi bi-play-fill" aria-hidden="true"></i>
    </button>
    <input class="js-tablet-input-replay-time" type="range" min="0" max="0" value="0" step="1" aria-label="Replay time">
    <output class="small text-muted js-tablet-input-replay-label" aria-live="polite">0 ms</output>
  </div>
  {{/replay}}
  {{#reference}}<p class="small text-muted mb-1">Reference drawing</p>{{/reference}}
  <div class="pl-tablet-input-surface">
    {{#background_url}}<img class="pl-tablet-input-background pl-tablet-input-background-{{background_fit}}" src="{{background_url}}" alt="">{{/background_url}}
    <canvas class="pl-tablet-input-canvas" width="{{width}}" height="{{height}}" tabindex="0" aria-label="Tablet input canvas"></canvas>
  </div>
  {{#editable}}<input type="hidden" name="{{name}}" class="js-tablet-input-answer">{{/editable}}
  {{#submission}}
  <div class="mt-2">
    {{#correct}}<span class="badge text-bg-success"><i class="fas fa-check" aria-hidden="true"></i> 100%</span>{{/correct}}
    {{#partial}}<span class="badge text-bg-warning"><i class="far fa-circle" aria-hidden="true"></i> {{partial}}%</span>{{/partial}}
    {{#incorrect}}<span class="badge text-bg-danger"><i class="fas fa-times" aria-hidden="true"></i> 0%</span>{{/incorrect}}
    {{#feedback}}<span class="small ms-1">{{feedback}}</span>{{/feedback}}
    {{#format_error}}<span class="badge text-bg-danger">Invalid</span> <span class="small">{{format_error}}</span>{{/format_error}}
  </div>
  {{/submission}}
</div>
<script>
  window.PLTabletInput?.init(document.currentScript.previousElementSibling);
</script>
